# ===== LLM / Embedding =====
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-3-small
LLM_STUB=0

# ===== HTTP =====
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
MILVUS_ADDRESS=127.0.0.1:19530

# ===== Security =====
# Local development only. Production must use token + a strong secret.
AUTH_MODE=disabled
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173
# 公开部署时设为 1：/api/sessions/* 挂管理员认证（本地默认 0 不影响使用）
PROTECT_SESSIONS=0
# 启动时自动对孤儿文档（indexed 但 0 切片）重新切片入库
RECONCILE_ON_BOOT=0

# In-process per-IP limits and windows.
RATE_CHAT_LIMIT=30
RATE_UPLOAD_LIMIT=20
RATE_SEARCH_LIMIT=60
RATE_MANAGEMENT_LIMIT=120
RATE_CHAT_WINDOW_MS=60000
RATE_UPLOAD_WINDOW_MS=60000
RATE_SEARCH_WINDOW_MS=60000
RATE_MANAGEMENT_WINDOW_MS=60000

# ===== Milvus Compose (place these in project-root .env when using Compose) =====
MILVUS_VERSION=v2.5.10
ETCD_VERSION=v3.5.18
MINIO_VERSION=RELEASE.2024-06-13T22-53-53Z
MILVUS_ETCD_PORT=2379
MILVUS_GRPC_PORT=19530
MILVUS_HTTP_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=milvusadmin
MINIO_ROOT_PASSWORD=change-me-local-only
